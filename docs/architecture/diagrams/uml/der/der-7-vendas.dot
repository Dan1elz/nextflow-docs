digraph der7 {
  graph [rankdir=TB, splines=spline, nodesep=0.35, ranksep=0.75, fontname="Arial", fontsize=26,
         label="Vendas e promoções", labelloc=t, pad=0.3, bgcolor=white];
  node [shape=plaintext, fontname="Arial", fontsize=21];
  edge [fontname="Arial", fontsize=28, color="#555555", penwidth=1.6, dir=both, arrowsize=1.1];
  orders [label=<<table border="2" color="#1565C0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E3F2FD" border="1" color="#1565C0" cellpadding="7"><b>Venda (orders)</b></td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">id</td><td align="left" border="1" color="#1565C0" cellpadding="5">PK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">store_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">sale_location_id</td><td align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">client_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">user_id</td><td align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">int</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">number</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">smallint</td><td align="left" border="1" color="#1565C0" cellpadding="5">status</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">paga ou cancelada</td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">smallint</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">channel</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">balcão</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">subtotal</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">discount_total</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">total</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">cash_received</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">change</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">timestamptz</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">paid_at</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr></table>>];
  order_items [label=<<table border="2" color="#1565C0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E3F2FD" border="1" color="#1565C0" cellpadding="7"><b>Item da venda (order_items)</b></td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">id</td><td align="left" border="1" color="#1565C0" cellpadding="5">PK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">order_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">variant_id</td><td align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">promotion_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">int</td><td align="left" border="1" color="#1565C0" cellpadding="5">position</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">quantity</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">list_price</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">unit_price</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">discount</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">line_total</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td align="left" border="1" color="#1565C0" cellpadding="5">unit_cost</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr></table>>];
  payments [label=<<table border="2" color="#1565C0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E3F2FD" border="1" color="#1565C0" cellpadding="7"><b>Pagamento (payments)</b></td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">id</td><td align="left" border="1" color="#1565C0" cellpadding="5">PK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">order_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">smallint</td><td align="left" border="1" color="#1565C0" cellpadding="5">method</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">dinheiro, crédito, débito,<br/>transferência, Pix</td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">amount</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr></table>>];
  promotions [label=<<table border="2" color="#1565C0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E3F2FD" border="1" color="#1565C0" cellpadding="7"><b>Promoção (promotions)</b></td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">id</td><td align="left" border="1" color="#1565C0" cellpadding="5">PK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">product_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">variant_id</td><td align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">forecast_recommendation_id</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">uuid</td><td align="left" border="1" color="#1565C0" cellpadding="5">created_by</td><td align="left" border="1" color="#1565C0" cellpadding="5">FK</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">numeric</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">discount_percent</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">date</td><td align="left" border="1" color="#1565C0" cellpadding="5">start_date</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">date</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">end_date</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">varchar</td><td align="left" border="1" color="#1565C0" cellpadding="5">reason</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">smallint</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">source</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">manual ou da IA</td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">bool</td><td align="left" border="1" color="#1565C0" cellpadding="5">below_cost_confirmed</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">bool</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5">is_active</td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td><td bgcolor="#E3F2FD" align="left" border="1" color="#1565C0" cellpadding="5"> </td></tr><tr><td align="left" border="1" color="#1565C0" cellpadding="5">timestamptz</td><td align="left" border="1" color="#1565C0" cellpadding="5">canceled_at</td><td align="left" border="1" color="#1565C0" cellpadding="5"> </td><td align="left" border="1" color="#1565C0" cellpadding="5">opcional</td></tr></table>>];
  clients [label=<<table border="2" color="#F9A825" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#FFF8E1" border="1" color="#F9A825" cellpadding="7"><b>Cliente (clients)</b></td></tr><tr><td align="left" border="1" color="#F9A825" cellpadding="5">uuid</td><td align="left" border="1" color="#F9A825" cellpadding="5">id</td><td align="left" border="1" color="#F9A825" cellpadding="5">PK</td><td align="left" border="1" color="#F9A825" cellpadding="5">detalhado no DER 2</td></tr></table>>];
  users [label=<<table border="2" color="#C2185B" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#FCE4EC" border="1" color="#C2185B" cellpadding="7"><b>Usuário (users)</b></td></tr><tr><td align="left" border="1" color="#C2185B" cellpadding="5">uuid</td><td align="left" border="1" color="#C2185B" cellpadding="5">id</td><td align="left" border="1" color="#C2185B" cellpadding="5">PK</td><td align="left" border="1" color="#C2185B" cellpadding="5">detalhado no DER 1</td></tr></table>>];
  stores [label=<<table border="2" color="#2E7D32" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E8F5E9" border="1" color="#2E7D32" cellpadding="7"><b>Loja (stores)</b></td></tr><tr><td align="left" border="1" color="#2E7D32" cellpadding="5">uuid</td><td align="left" border="1" color="#2E7D32" cellpadding="5">id</td><td align="left" border="1" color="#2E7D32" cellpadding="5">PK</td><td align="left" border="1" color="#2E7D32" cellpadding="5">detalhado no DER 5</td></tr></table>>];
  stock_locations [label=<<table border="2" color="#2E7D32" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E8F5E9" border="1" color="#2E7D32" cellpadding="7"><b>Local de estoque<br/>(stock_locations)</b></td></tr><tr><td align="left" border="1" color="#2E7D32" cellpadding="5">uuid</td><td align="left" border="1" color="#2E7D32" cellpadding="5">id</td><td align="left" border="1" color="#2E7D32" cellpadding="5">PK</td><td align="left" border="1" color="#2E7D32" cellpadding="5">detalhado no DER 5</td></tr></table>>];
  products [label=<<table border="2" color="#5E35B1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#EDE7F6" border="1" color="#5E35B1" cellpadding="7"><b>Produto (products)</b></td></tr><tr><td align="left" border="1" color="#5E35B1" cellpadding="5">uuid</td><td align="left" border="1" color="#5E35B1" cellpadding="5">id</td><td align="left" border="1" color="#5E35B1" cellpadding="5">PK</td><td align="left" border="1" color="#5E35B1" cellpadding="5">detalhado no DER 3</td></tr></table>>];
  product_variants [label=<<table border="2" color="#5E35B1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#EDE7F6" border="1" color="#5E35B1" cellpadding="7"><b>Variação do produto<br/>(product_variants)</b></td></tr><tr><td align="left" border="1" color="#5E35B1" cellpadding="5">uuid</td><td align="left" border="1" color="#5E35B1" cellpadding="5">id</td><td align="left" border="1" color="#5E35B1" cellpadding="5">PK</td><td align="left" border="1" color="#5E35B1" cellpadding="5">detalhado no DER 3</td></tr></table>>];
  forecast_recommendations [label=<<table border="2" color="#00838F" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="4" bgcolor="#E0F7FA" border="1" color="#00838F" cellpadding="7"><b>Recomendação<br/>(forecast_recommendations)</b></td></tr><tr><td align="left" border="1" color="#00838F" cellpadding="5">uuid</td><td align="left" border="1" color="#00838F" cellpadding="5">id</td><td align="left" border="1" color="#00838F" cellpadding="5">PK</td><td align="left" border="1" color="#00838F" cellpadding="5">detalhado no DER 9</td></tr></table>>];
  { rank=same; clients; stores; stock_locations }
  { rank=same; users; orders }
  { rank=same; products; forecast_recommendations; payments }
  { rank=same; promotions; product_variants }
  { rank=same; order_items }
