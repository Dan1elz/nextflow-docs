  stock_locations -> orders [arrowtail=teetee, arrowhead=crowodot, label="  baixa de  "];
  clients -> orders [arrowtail=teeodot, arrowhead=crowodot, label="  compra  "];
  users -> orders [arrowtail=teetee, arrowhead=crowodot, label="  vende  "];
  orders -> order_items [arrowtail=teetee, arrowhead=crowodot, label="  contém  "];
  orders -> payments [arrowtail=teetee, arrowhead=crowodot, label="  é paga com  "];
  promotions -> order_items [arrowtail=teeodot, arrowhead=crowodot, label="  aplica desconto  "];
  product_variants -> order_items [arrowtail=teetee, arrowhead=crowodot, label="  é vendida  "];
  users -> promotions [arrowtail=teetee, arrowhead=crowodot, label="  cria  "];
  products -> promotions [arrowtail=teetee, arrowhead=crowodot, label="  tem promoções  "];
  product_variants -> promotions [arrowtail=teeodot, arrowhead=crowodot, label="  tem promoção  "];
