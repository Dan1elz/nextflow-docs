@startuml classes-3-produto
!include ../../estilo.iuml
skinparam dpi 170
skinparam classAttributeIconSize 0
skinparam class {
  BorderThickness 1.4
  FontSize 14
  AttributeFontSize 13
}
hide empty members
skinparam class<<acesso>> {
  BackgroundColor #FCE4EC
  HeaderBackgroundColor #F8BBD0
  BorderColor #C2185B
}
hide <<acesso>> stereotype
skinparam class<<cadastro>> {
  BackgroundColor #FFF8E1
  HeaderBackgroundColor #FFE082
  BorderColor #F9A825
}
hide <<cadastro>> stereotype
skinparam class<<produto>> {
  BackgroundColor #EDE7F6
  HeaderBackgroundColor #D1C4E9
  BorderColor #5E35B1
}
hide <<produto>> stereotype
skinparam class<<estoque>> {
  BackgroundColor #E8F5E9
  HeaderBackgroundColor #C8E6C9
  BorderColor #2E7D32
}
hide <<estoque>> stereotype
skinparam class<<venda>> {
  BackgroundColor #E3F2FD
  HeaderBackgroundColor #BBDEFB
  BorderColor #1565C0
}
hide <<venda>> stereotype
skinparam class<<compra>> {
  BackgroundColor #FFF3E0
  HeaderBackgroundColor #FFCC80
  BorderColor #EF6C00
}
hide <<compra>> stereotype
skinparam class<<previsao>> {
  BackgroundColor #E0F7FA
  HeaderBackgroundColor #B2EBF2
  BorderColor #00838F
}
hide <<previsao>> stereotype
title <size:20>Classes — Produto, variações e preço</size>

class "Product\n<size:11><i>Produto</i></size>" as Product <<produto>> {
  + Name : string
  + Brand : string?
  + Description : string?
  + ProductType : ProductTypeEnum
  + SaleUnit : SaleUnitEnum
  + DecimalPlaces : short
  + AllowsNegative : bool
  + HasVariants : bool
  + TracksLots : bool
  + ShelfLifeDays : int?
  + Lifecycle : LifecycleEnum
  + LaunchedOn : DateOnly?
  + DefaultMinQuantity : decimal
  + TargetCoverageDays : int?
  + AbcClass : AbcClassEnum?
  + ImageKey : string?
  + IsActive : bool
  --
  + Product(dto, changedById, today)
  + Update(dto, changedById, today) : void
  + Delete() : void
  + Reactivate() : void
  + ChangeLifecycle(lifecycle) : void
  + ApplyAbcClass(abcClass) : void
  + SetImage(key) : void
  + RemoveImage() : void
  + EffectiveMinimum(variant, locationId) : decimal
  + IsBelowMinimum(variant, locationId, available) : bool
}
class "ProductVariant\n<size:11><i>Variação do produto</i></size>" as ProductVariant <<produto>> {
  + Sku : string
  + Barcode : string?
  + Price : decimal
  + SortOrder : short
  + IsActive : bool
  + RemovedOn : DateOnly?
  + AverageCost : decimal?
  + LastCost : decimal?
  --
  + ProductVariant(dto, product, sortOrder, changedById, today)
  + Update(dto, sortOrder, changedById, today) : void
  + Remove(today) : void
  + ApplyInboundCost(companyQuantityBefore, quantity, unitCost) : void
  + SyncValues(attributeValueIds) : void
  + SyncMinimums(IReadOnlyDictionary<Guid, minimumsByLocation) : void
}
class "ProductAttribute\n<size:11><i>Atributo da grade</i></size>" as ProductAttribute <<produto>> {
  + Name : string
  + SortOrder : short
  --
  + ProductAttribute(dto, productId, sortOrder)
  + Update(dto, sortOrder) : void
  + SyncValues(dtos, Dictionary<string, valueIds) : void
}
class "ProductAttributeValue\n<size:11><i>Valor do atributo</i></size>" as ProductAttributeValue <<produto>> {
  + Value : string
  + SortOrder : short
  --
  + ProductAttributeValue(dto, attributeId, sortOrder)
  + Update(dto, sortOrder) : void
}
class "ProductVariantValue\n<size:11><i>Valor da variação</i></size>" as ProductVariantValue <<produto>> {
  --
  + ProductVariantValue(variantId, attributeValueId)
}
class "PriceHistory\n<size:11><i>Histórico de preço</i></size>" as PriceHistory <<produto>> {
  + Price : decimal
  + ValidFrom : DateOnly
  + ValidTo : DateOnly?
  --
  + PriceHistory(variantId, price, validFrom, changedById)
  + Close(validTo) : void
}
class "CategoryProduct\n<size:11><i>ver Classificação</i></size>" as CategoryProduct <<produto>>
class "Collection\n<size:11><i>ver Classificação</i></size>" as Collection <<produto>>
class "ProductEvent\n<size:11><i>ver Classificação</i></size>" as ProductEvent <<produto>>
class "ProductSupplier\n<size:11><i>ver Classificação</i></size>" as ProductSupplier <<produto>>
class "Promotion\n<size:11><i>ver Vendas</i></size>" as Promotion <<venda>>
class "StockBalance\n<size:11><i>ver Estoque</i></size>" as StockBalance <<estoque>>
class "StockLocationMinimum\n<size:11><i>ver Estoque</i></size>" as StockLocationMinimum <<estoque>>
class "User\n<size:11><i>ver Acesso</i></size>" as User <<acesso>>

Product "*" --> "0..1" Collection : Collection
Product "1" -- "*" CategoryProduct : Categories
Product "1" *-- "*" ProductAttribute : Attributes
Product "1" *-- "*" ProductVariant : Variants
Product "1" -- "*" ProductEvent : Events
Product "1" -- "*" ProductSupplier : Suppliers
Product "1" -- "*" Promotion : Promotions
ProductVariant "1" *-- "*" ProductVariantValue : AttributeValues
ProductVariant "1" *-- "*" PriceHistory : PriceHistory
ProductVariant "1" -- "*" StockBalance : Balances
ProductVariant "1" *-- "*" StockLocationMinimum : LocationMinimums
ProductAttribute "1" *-- "*" ProductAttributeValue : Values
ProductVariantValue "*" --> "1" ProductAttributeValue : AttributeValue
PriceHistory "*" --> "1" User : ChangedBy
note as Base
  Todas herdam de <b>BaseModel</b> (Id : Guid, CreatedAt : DateTime).
  Atributos com set privado: só o construtor e os métodos mudam o estado.
end note
@enduml
