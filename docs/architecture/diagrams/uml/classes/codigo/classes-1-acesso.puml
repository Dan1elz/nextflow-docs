@startuml classes-1-acesso
!include ../../estilo.iuml
skinparam dpi 170
skinparam classAttributeIconSize 0
skinparam class {
  BorderThickness 1.4
  FontSize 14
  AttributeFontSize 13
}
hide empty members
skinparam class<<acesso>> {
  BackgroundColor #FCE4EC
  HeaderBackgroundColor #F8BBD0
  BorderColor #C2185B
}
hide <<acesso>> stereotype
skinparam class<<cadastro>> {
  BackgroundColor #FFF8E1
  HeaderBackgroundColor #FFE082
  BorderColor #F9A825
}
hide <<cadastro>> stereotype
skinparam class<<produto>> {
  BackgroundColor #EDE7F6
  HeaderBackgroundColor #D1C4E9
  BorderColor #5E35B1
}
hide <<produto>> stereotype
skinparam class<<estoque>> {
  BackgroundColor #E8F5E9
  HeaderBackgroundColor #C8E6C9
  BorderColor #2E7D32
}
hide <<estoque>> stereotype
skinparam class<<venda>> {
  BackgroundColor #E3F2FD
  HeaderBackgroundColor #BBDEFB
  BorderColor #1565C0
}
hide <<venda>> stereotype
skinparam class<<compra>> {
  BackgroundColor #FFF3E0
  HeaderBackgroundColor #FFCC80
  BorderColor #EF6C00
}
hide <<compra>> stereotype
skinparam class<<previsao>> {
  BackgroundColor #E0F7FA
  HeaderBackgroundColor #B2EBF2
  BorderColor #00838F
}
hide <<previsao>> stereotype
title <size:20>Classes — Acesso e notificações</size>

class "User\n<size:11><i>Usuário</i></size>" as User <<acesso>> {
  + Name : string
  + LastName : string
  + Cpf : TaxDocument
  + BirthDate : DateOnly
  + Email : string
  + PasswordHash : string
  + Role : RoleEnum
  + IsActive : bool
  + LastLoginAt : DateTime?
  + FullName : string {readOnly}
  --
  + User(dto, passwordHash)
  + Update(dto) : void
  + UpdateProfile(dto) : void
  + ChangePassword(passwordHash) : void
  + RegisterLogin(utcNow) : void
  + Delete() : void
  + Reactivate() : void
  + {static} NormalizeEmail(email) : string
}
class "UserStore\n<size:11><i>Loja do usuário</i></size>" as UserStore <<acesso>> {
  + UserId : Guid
  --
  + UserStore(userId, storeId)
}
class "Notification\n<size:11><i>Notificação</i></size>" as Notification <<acesso>> {
  + Type : NotificationTypeEnum
  + Title : string
  + Message : string
  + Link : string?
  + DigestDate : DateOnly?
  + ReadAt : DateTime?
  + IsRead : bool {readOnly}
  --
  + Notification(dto, userId)
  + MarkRead(utcNow) : void
}
class "Store\n<size:11><i>ver Estoque</i></size>" as Store <<estoque>>

UserStore "*" --> "1" Store : Store
Notification "*" --> "1" User : User
note as Base
  Todas herdam de <b>BaseModel</b> (Id : Guid, CreatedAt : DateTime).
  Atributos com set privado: só o construtor e os métodos mudam o estado.
end note
@enduml
