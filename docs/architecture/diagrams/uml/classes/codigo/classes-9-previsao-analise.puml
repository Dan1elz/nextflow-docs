@startuml classes-9-previsao-analise
!include ../../estilo.iuml
skinparam dpi 170
skinparam classAttributeIconSize 0
skinparam class {
  BorderThickness 1.4
  FontSize 14
  AttributeFontSize 13
}
hide empty members
skinparam class<<acesso>> {
  BackgroundColor #FCE4EC
  HeaderBackgroundColor #F8BBD0
  BorderColor #C2185B
}
hide <<acesso>> stereotype
skinparam class<<cadastro>> {
  BackgroundColor #FFF8E1
  HeaderBackgroundColor #FFE082
  BorderColor #F9A825
}
hide <<cadastro>> stereotype
skinparam class<<produto>> {
  BackgroundColor #EDE7F6
  HeaderBackgroundColor #D1C4E9
  BorderColor #5E35B1
}
hide <<produto>> stereotype
skinparam class<<estoque>> {
  BackgroundColor #E8F5E9
  HeaderBackgroundColor #C8E6C9
  BorderColor #2E7D32
}
hide <<estoque>> stereotype
skinparam class<<venda>> {
  BackgroundColor #E3F2FD
  HeaderBackgroundColor #BBDEFB
  BorderColor #1565C0
}
hide <<venda>> stereotype
skinparam class<<compra>> {
  BackgroundColor #FFF3E0
  HeaderBackgroundColor #FFCC80
  BorderColor #EF6C00
}
hide <<compra>> stereotype
skinparam class<<previsao>> {
  BackgroundColor #E0F7FA
  HeaderBackgroundColor #B2EBF2
  BorderColor #00838F
}
hide <<previsao>> stereotype
title <size:20>Classes — Previsão: análise e recomendação</size>

class "ForecastRun\n<size:11><i>Análise de previsão</i></size>" as ForecastRun <<previsao>> {
  + Trigger : ForecastTriggerEnum
  + HorizonMonths : short
  + Status : ForecastRunStatusEnum
  + ReferenceDate : DateOnly
  + StartedAt : DateTime
  + FinishedAt : DateTime?
  + DurationMs : int?
  + AiProvider : string?
  + AiModel : string?
  + Summary : string?
  + ErrorMessage : string?
  + ProductsAnalyzed : int
  + ProductsSentToAi : int
  + BatchesTotal : int
  + BatchesCompleted : int
  + BatchesFailed : int
  + IsRunning : bool {readOnly}
  --
  + ForecastRun(dto, referenceDate, startedAtUtc)
  + BeginAnalysis(horizonMonths, productsAnalyzed, productsSentToAi, batchesTotal) : void
  + RecordBatch(completed) : void
  + Complete(status, summary, errorMessage, aiProvider, aiModel, finishedAtUtc) : void
  + Fail(errorMessage, finishedAtUtc) : void
}
class "ForecastRecommendation\n<size:11><i>Recomendação</i></size>" as ForecastRecommendation <<previsao>> {
  + Action : RecommendationActionEnum
  + Priority : RecommendationPriorityEnum
  + Confidence : ForecastConfidenceEnum
  + Status : RecommendationStatusEnum
  + SuggestedQuantity : decimal?
  + CalculatedQuantity : decimal?
  + SuggestedDiscountPercent : decimal?
  + SuggestedPromotionDays : int?
  + Deadline : DateOnly?
  + Reason : string
  + ReasonCalculated : string
  + AiAdjusted : bool
  + CurrentStock : decimal
  + IncomingStock : decimal
  + ProjectedDemand : decimal
  + NextMonthDemand : decimal
  + CoverageDays : decimal?
  + NextMonthSeasonalIndex : decimal
  + SafetyStock : decimal
  + LeadTimeDays : int
  + LeadTimeSource : LeadTimeSourceEnum
  + MonthsOfHistory : short
  + BasedOnLastYear : bool
  + AppliedAt : DateTime?
  + AppliedById : Guid?
  + AppliedTransferId : Guid?
  + DismissReason : string?
  + DismissReasonCode : DismissReasonEnum?
  + IsPending : bool {readOnly}
  --
  + ForecastRecommendation(dto)
  + ApplyPurchase(purchaseOrderId, appliedById, utcNow) : void
  + ApplyPromotion(promotionId, appliedById, utcNow) : void
  + ApplyTransfer(transferId, appliedById, utcNow) : void
  + Dismiss(reasonCode, note, dismissedById, utcNow) : void
  + RevertPurchase(canceledOrderId, stillOpenOrderId, fromLatestRun, utcNow) : void
  + Expire(utcNow) : void
}
class "ForecastAiBatch\n<size:11><i>Lote enviado à IA</i></size>" as ForecastAiBatch <<previsao>> {
  + BatchNumber : short
  + ProductsCount : int
  + ProductIds : Guid[]
  + Status : AiBatchStatusEnum
  + ErrorMessage : string?
  + DurationMs : int?
  + SentAt : DateTime?
  + FinishedAt : DateTime?
  --
  + ForecastAiBatch(dto)
  + MarkSent(utcNow) : void
  + MarkCompleted(durationMs, utcNow) : void
  + MarkFailed(errorMessage, durationMs, utcNow) : void
}
class "ForecastProjection\n<size:11><i>Projeção mensal</i></size>" as ForecastProjection <<previsao>> {
  + Year : short
  + Month : short
  + ProjectedQuantity : decimal
  --
  + ForecastProjection(dto)
}
class "ForecastSettings\n<size:11><i>Agendamento da previsão</i></size>" as ForecastSettings <<previsao>> {
  + ScheduleEnabled : bool
  + Weekday : DayOfWeek
  + Time : TimeOnly
  + AiBatchSize : int
  --
  + ForecastSettings()
  + ForecastSettings(dto, updatedById, utcNow)
  + Update(dto, updatedById, utcNow) : void
}
class "ForecastRecommendationItem\n<size:11><i>ver Previsão (aplicação)</i></size>" as ForecastRecommendationItem <<previsao>>
class "ForecastRecommendationPurchaseOrder\n<size:11><i>ver Previsão (aplicação)</i></size>" as ForecastRecommendationPurchaseOrder <<previsao>>
class "ForecastRecommendationStore\n<size:11><i>ver Previsão (aplicação)</i></size>" as ForecastRecommendationStore <<previsao>>
class "Product\n<size:11><i>ver Produto</i></size>" as Product <<produto>>
class "Promotion\n<size:11><i>ver Vendas</i></size>" as Promotion <<venda>>
class "PurchaseOrder\n<size:11><i>ver Compras</i></size>" as PurchaseOrder <<compra>>
class "StockLocation\n<size:11><i>ver Estoque</i></size>" as StockLocation <<estoque>>
class "User\n<size:11><i>ver Acesso</i></size>" as User <<acesso>>

ForecastRun "*" --> "0..1" User : RequestedBy
ForecastRun "1" *-- "*" ForecastAiBatch : Batches
ForecastRun "1" *-- "*" ForecastRecommendation : Recommendations
ForecastRun "1" *-- "*" ForecastProjection : Projections
ForecastRecommendation "*" --> "1" Product : Product
ForecastRecommendation "*" --> "0..1" PurchaseOrder : AppliedPurchaseOrder
ForecastRecommendation "*" --> "0..1" Promotion : AppliedPromotion
ForecastRecommendation "*" --> "0..1" StockLocation : TransferFromLocation
ForecastRecommendation "*" --> "0..1" StockLocation : TransferToLocation
ForecastRecommendation "1" *-- "*" ForecastRecommendationItem : Items
ForecastRecommendation "1" *-- "*" ForecastRecommendationPurchaseOrder : PurchaseOrders
ForecastRecommendation "1" *-- "*" ForecastRecommendationStore : Stores
ForecastProjection "*" --> "1" Product : Product
ForecastSettings "*" --> "0..1" User : UpdatedBy
note as Base
  Todas herdam de <b>BaseModel</b> (Id : Guid, CreatedAt : DateTime).
  Atributos com set privado: só o construtor e os métodos mudam o estado.
end note
@enduml
