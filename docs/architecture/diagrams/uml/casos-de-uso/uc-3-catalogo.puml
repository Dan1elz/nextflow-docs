@startuml uc-3-catalogo
!include ../estilo.iuml
left to right direction
title Casos de uso — Catálogo de produtos

actor "Administrador" as Admin

rectangle "Nextflow — Catálogo" {
  usecase "UC12 Gerenciar produtos" as UC12
  usecase "UC13 Manter variações\n(grade de tamanho, sabor, cor)" as UC13
  usecase "UC14 Vincular fornecedores\n(prazo, mínimo, múltiplo)" as UC14
  usecase "UC15 Alterar ciclo de vida\n(em linha ou fora de linha)" as UC15
  usecase "UC16 Gerenciar categorias\n(2 níveis)" as UC16
  usecase "UC17 Gerenciar coleções" as UC17
  usecase "UC18 Gerenciar calendário\nde eventos comerciais" as UC18
}

Admin --> UC12
Admin --> UC16
Admin --> UC17
Admin --> UC18
UC12 ..> UC13 : <<include>>
UC14 .> UC12 : <<extend>>
UC15 .> UC12 : <<extend>>

@enduml
